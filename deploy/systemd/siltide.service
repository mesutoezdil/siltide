[Unit]
Description=siltide accelerator monitor (headless collector with API and /metrics)
Documentation=https://github.com/moezdil/siltide
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/siltide --service --listen 127.0.0.1:9800
Restart=on-failure
RestartSec=5s
Environment=SILTIDE_STATE_DIR=/var/lib/siltide
Environment=SILTIDE_CONFIG=/etc/siltide/config.yaml
StateDirectory=siltide
ConfigurationDirectory=siltide
# siltide reads vendor tools and /proc; it never needs root on NVIDIA and
# Apple. Uncomment when a vendor CLI insists on it.
#User=siltide
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/siltide

[Install]
WantedBy=multi-user.target
